DOMAIN=arobase.chat
ACME_EMAIL=admin@arobase.chat
REGISTRY=0x_adresse_du_registry
REGISTRY_RPC=https://gnosis-rpc.arobase.chat,https://rpc.gnosischain.com
MONITOR_WEBHOOK=
MONITOR_BALANCES=100:0x_executor_gnosis:0.3:executor,5042:0x_executor_arc:0.5:executor,8453:0x_executor_base:0.002:executor
MONITOR_MIN_DEPOSITS=100:0.5,5042:1,8453:0.003
RPC_GNOSIS=https://gnosis-rpc.arobase.chat https://rpc.gnosischain.com https://gnosis-rpc.publicnode.com
RPC_ARC=https://arc-rpc.arobase.chat https://rpc.mainnet.arc.io https://arc-rpc.publicnode.com
RPC_BASE=https://base-rpc.arobase.chat https://mainnet.base.org https://base-rpc.publicnode.com
# Relay source, pinned to an exact commit (or a signed tag). Never use a branch.
RELAY_CONTEXT=https://github.com/arobasechat/arobase-chat-push-relay.git#<commit-sha>
# Or build from a local checkout: RELAY_CONTEXT=../arobase-chat-push-relay
# Requests per minute and per IP on each bundler
RATE_LIMIT=120
